{
  "rules": {
    ".read": false,
    ".write": false,
    "presence": {
      ".read": true,
      "$id": {
        ".write": "auth != null && auth.uid === $id",
        ".validate": "newData.hasChild('t') && newData.child('t').isNumber() && newData.child('t').val() <= now + 60000",
        "t": {
          ".validate": "newData.isNumber()"
        },
        "s": {
          ".validate": "newData.isString() && (newData.val() === 'play' || newData.val() === 'menu')"
        },
        "m": {
          ".validate": "newData.isString() && newData.val().length <= 12"
        },
        "v": {
          ".validate": "newData.isString() && newData.val().length <= 16"
        },
        "tg": {
          ".validate": "newData.isBoolean()"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "stats": {
      ".read": true,
      "$day": {
        ".validate": "$day.matches(/^20[0-9][0-9]-[0-9][0-9]-[0-9][0-9]$/)",
        "devices": {
          "$id": {
            ".write": "auth != null && auth.uid === $id",
            ".validate": "newData.val() === true"
          }
        },
        "$counter": {
          ".write": "auth != null && ($counter === 'opens' || $counter === 'telegram' || $counter === 'runs' || $counter === 'finished' || $counter === 'wins' || $counter === 'secs' || $counter === 'errors')",
          ".validate": "newData.isNumber() && newData.val() >= 0 && ($counter === 'secs' ? ((!data.exists() && newData.val() <= 1200) || (data.exists() && newData.val() > data.val() && newData.val() <= data.val() + 1200)) : ((!data.exists() && newData.val() === 1) || (data.exists() && newData.val() === data.val() + 1)))"
        }
      }
    },
    "errors": {
      ".read": true,
      "$day": {
        ".validate": "$day.matches(/^20[0-9][0-9]-[0-9][0-9]-[0-9][0-9]$/)",
        "$error": {
          ".write": "auth != null && !data.exists()",
          ".validate": "newData.hasChildren(['m', 't', 'u']) && newData.child('u').val() === auth.uid && newData.child('m').isString() && newData.child('m').val().length <= 260",
          "m": {
            ".validate": "newData.isString()"
          },
          "t": {
            ".validate": "newData.isNumber() && newData.val() <= now + 60000"
          },
          "u": {
            ".validate": "newData.isString()"
          },
          "v": {
            ".validate": "newData.isString() && newData.val().length <= 16"
          },
          "ua": {
            ".validate": "newData.isString() && newData.val().length <= 12"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "scores": {
      ".read": true,
      ".indexOn": [
        "score"
      ],
      "$id": {
        ".write": "auth != null && auth.uid === $id",
        ".validate": "newData.hasChildren(['name', 'score', 'secs', 'kills', 'at', 'proto']) && ((newData.child('kills').val() <= 9999 && newData.child('score').val() === newData.child('proto').val() * 1000000000 + newData.child('secs').val() * 10000 + newData.child('kills').val()) || (newData.child('kills').val() > 9999 && newData.child('score').val() === newData.child('proto').val() * 1000000000 + newData.child('secs').val() * 10000 + 9999)) && newData.child('kills').val() <= newData.child('secs').val() * 60 + 200",
        "name": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 16"
        },
        "score": {
          ".validate": "newData.isNumber()"
        },
        "secs": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1300 && newData.val() % 1 === 0"
        },
        "kills": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 500000 && newData.val() % 1 === 0"
        },
        "won": {
          ".validate": "newData.isBoolean()"
        },
        "at": {
          ".validate": "newData.isNumber() && newData.val() <= now + 60000"
        },
        "$other": {
          ".validate": false
        },
        "level": {
          ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 500"
        },
        "proto": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 5 && newData.val() % 1 === 0"
        },
        "prog": {
          ".validate": "newData.isString() && newData.val().length <= 160"
        }
      }
    },
    "daily": {
      ".read": true,
      "$day": {
        ".indexOn": [
          "score"
        ],
        ".validate": "$day.matches(/^20[0-9][0-9]-[0-9][0-9]-[0-9][0-9]$/)",
        "$id": {
          ".write": "auth != null && auth.uid === $id",
          ".validate": "newData.hasChildren(['name', 'score', 'secs', 'kills', 'at']) && ((newData.child('kills').val() <= 9999 && newData.child('score').val() === newData.child('secs').val() * 10000 + newData.child('kills').val()) || (newData.child('kills').val() > 9999 && newData.child('score').val() === newData.child('secs').val() * 10000 + 9999)) && newData.child('kills').val() <= newData.child('secs').val() * 60 + 200",
          "name": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 16"
          },
          "score": {
            ".validate": "newData.isNumber()"
          },
          "secs": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1300 && newData.val() % 1 === 0"
          },
          "kills": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 500000 && newData.val() % 1 === 0"
          },
          "won": {
            ".validate": "newData.isBoolean()"
          },
          "at": {
            ".validate": "newData.isNumber() && newData.val() <= now + 60000"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    }
  }
}